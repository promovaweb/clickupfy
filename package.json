{
  "name": "clickupfy",
  "version": "1.1.2",
  "description": "CLI, TUI and MCP stdio server to manage ClickUp Sprints, tasks, Docs and time tracking.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "clickupfy": "src/main.ts"
  },
  "termfy": {
    "bin": "clickupfy",
    "title": "ClickUpfy",
    "author": "Promovaweb",
    "site": "https://promovaweb.com/docs/clickupfy",
    "repository": "https://github.com/promovaweb/clickupfy",
    "framework": "https://github.com/promovaweb/termfy",
    "starterKit": "0.9.2"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "tui": "bun run src/main.ts",
    "mcp": "bun run src/main.ts mcp",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "opencli": "bun run src/main.ts --opencli > docs/opencli.json",
    "opencli:check": "bun run scripts/check-opencli.ts",
    "skills:install": "npx -y skills add https://github.com/promovaweb/termfy -y -a universal -a claude-code -a codex -a opencode -a cursor -a gemini-cli",
    "skills:update": "npx -y skills update -y -p",
    "skills:check": "bun run scripts/check-skills.ts",
    "init": "bun run scripts/init.ts",
    "api:generate": "bun run scripts/generate-api.ts",
    "validate": "bun run typecheck && bun test && bun run skills:check && bun run opencli:check && bun run docs:check && bun run build",
    "docs:check": "bun run scripts/check-docs.ts",
    "npm:readme": "bun run scripts/npm-readme.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/clickupfy.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.4",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
