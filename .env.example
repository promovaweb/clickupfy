# Optional master key to encrypt credentials.json.
# Without this variable, the CLI generates and uses ~/.clickupfy/master.key.
# Generate a value with: openssl rand -hex 32
# CLICKUPFY_MASTER_KEY=

# Alternative directory for settings.json and credentials.json.
# Default: ~/.clickupfy
# CLICKUPFY_HOME=

# Disable colors in text output (community standard: https://no-color.org).
# NO_COLOR=1
